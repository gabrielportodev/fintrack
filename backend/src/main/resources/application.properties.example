# Application Name
spring.application.name=backend

# Port
server.port=8081

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/fintrack_db
spring.datasource.username=SEU_USUARIO_POSTGRES
spring.datasource.password=SUA_SENHA_POSTGRES
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Configuration
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# JWT — gere uma chave aleatória de no mínimo 256 bits (32 caracteres)
jwt.secret=sua-chave-secreta-minimo-256-bits-troque-em-producao
jwt.expiration=3600000

# Resend — necessário para o fluxo de recuperação de senha
# Crie sua chave gratuita em https://resend.com
resend.api.key=re_SUA_CHAVE_RESEND

# URL do front-end (usada nos e-mails de recuperação de senha)
app.frontend.url=http://localhost:3000
